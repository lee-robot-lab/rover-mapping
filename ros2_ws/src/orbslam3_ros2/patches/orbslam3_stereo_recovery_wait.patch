+// Stereo 전용 복구 대기 설정을 검증하며 누락 시 stock 3초를 유지한다.
+double StereoRelocalizationWaitSeconds(const cv::FileStorage &settings)
+{
+    const cv::FileNode value = settings["Tracking.StereoRelocalizationWaitSeconds"];
+    if(value.empty())
+        return 3.0;
+    if(!value.isInt() && !value.isReal())
+        throw std::invalid_argument("Tracking.StereoRelocalizationWaitSeconds must be a finite number in [1, 60]");
+    const double seconds = static_cast<double>(value);
+    if(!std::isfinite(seconds) || seconds < 1.0 || seconds > 60.0)
+        throw std::invalid_argument("Tracking.StereoRelocalizationWaitSeconds must be a finite number in [1, 60]");
+    return seconds;
+}
+}
+
+// 설치한 native library가 설정 가능한 stereo 복구 대기를 지원하는지 확인한다.
+extern "C" bool orbslam3_has_stereo_recovery_wait() { return true; }
+extern "C" bool orbslam3_has_initial_stereo_relocalization() { return true; }
 
 

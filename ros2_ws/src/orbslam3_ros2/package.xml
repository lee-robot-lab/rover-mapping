<!-- =============================================================
package.xml
설명: ORB-SLAM3 Stereo-Inertial ROS 2 Jazzy adapter package manifest다.
사용법: colcon build에서 packages-select로 orbslam3_ros2를 선택한다.
================================================================ -->
<package format="3">
  <name>orbslam3_ros2</name>
  <version>0.1.0</version>
  <description>ROS 2 Jazzy adapter for official ORB-SLAM3 stereo-inertial tracking.</description>
  <maintainer email="rover@example.com">rover</maintainer>
  <license>GPL-3.0-only</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>cv_bridge</depend>
  <depend>diagnostic_msgs</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rosbag2_storage_mcap</exec_depend>
  <depend>geometry_msgs</depend>
  <depend>message_filters</depend>
  <depend>nav_msgs</depend>
  <depend>rclcpp</depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
